generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Designer {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  images Image[]
}

model Image {
  id              Int          @id @default(autoincrement())
  filename        String
  imageUrl        String
  description     String
  garmentType     String?
  style           String?
  material        String?
  colorPalette    String?
  pattern         String?
  season          String?
  occasion        String?
  consumerProfile String?
  trendNotes      String?
  continent       String?
  country         String?
  city            String?
  capturedYear    Int?
  capturedMonth   Int?
  capturedSeason  String?
  aiRawJson       String?
  createdAt       DateTime     @default(now())
  designerId      Int?
  designer        Designer?    @relation(fields: [designerId], references: [id])
  annotations     Annotation[]
}

model Annotation {
  id        Int      @id @default(autoincrement())
  imageId   Int
  tags      String?
  notes     String?
  createdAt DateTime @default(now())
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
}